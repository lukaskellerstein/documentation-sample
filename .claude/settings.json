{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": ["Welcome to 7 Practical Office suite! "],
  "permissions": {
    "allow": [
      "Agent",
      "Artifact",
      "Bash",
      "Cd",
      "Edit",
      "EnterWorktree",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "KillShell",
      "LSP",
      "Monitor",
      "MultiEdit",
      "NotebookEdit",
      "PowerShell",
      "Read",
      "ShareOnboardingGuide",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write",

      "mcp__plugin_media-plugin_media-mcp",
      "mcp__plugin_media-plugin_ElevenLabs",
      "mcp__plugin_media-plugin_mermaid",
      "mcp__plugin_media-plugin_drawio",
      "mcp__plugin_media-plugin_media-playwright"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/)",
      "Bash(rm -r -f /)",
      "Bash(rm -r -f ~)",
      "Bash(rm -r -f /*)",
      "Bash(rm -r -f ~/)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf ~)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf ~/)",
      "Bash(sudo rm -r -f /)",
      "Bash(sudo rm -r -f ~)",
      "Bash(sudo rm -r -f /*)",
      "Bash(sudo rm -r -f ~/)",

      "Read(./.venv/**)",
      "Grep(./.venv/**)",
      "Edit(./.venv/**)",
      "Read(./**/venv/**)",
      "Grep(./**/venv/**)",
      "Read(./**/.venv/**)",
      "Grep(./**/.venv/**)",

      "Read(./node_modules/**)",
      "Grep(./node_modules/**)",
      "Edit(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Grep(./**/node_modules/**)",

      "Read(~/.ssh/**)",
      "Grep(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",

      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Grep(./**/.env)",
      "Read(./secrets/**)",
      "Read(./.secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./config/secrets.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",

      "Read(./.git/**)",
      "Grep(./.git/**)",
      "Edit(./.git/**)",
      "Read(./.git/worktrees/**)",

      "Read(./build/**)",
      "Grep(./build/**)",
      "Read(./dist/**)",
      "Grep(./dist/**)",
      "Read(./.next/**)",
      "Grep(./.next/**)",
      "Read(./.nuxt/**)",
      "Read(./out/**)",
      "Read(./__pycache__/**)",
      "Read(./**/__pycache__/**)",
      "Read(./.cache/**)",
      "Read(./.parcel-cache/**)",
      "Read(./.turbo/**)",
      "Read(./target/**)",
      "Read(./*.egg-info/**)",

      "Read(./.yarn/cache/**)",
      "Read(./.pnpm-store/**)",
      "Read(./.npm/**)",
      "Read(~/.npm/**)",
      "Read(~/.yarn/**)",
      "Read(~/.pnpm-store/**)",
      "Read(~/.cache/pip/**)",

      "Read(./.idea/**)",
      "Edit(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./*.swp)",
      "Read(./**/*.swp)",
      "Read(./*.swo)",
      "Read(./**/*.swo)",

      "Read(./.DS_Store)",
      "Read(./**/.DS_Store)",
      "Read(./Thumbs.db)",
      "Read(./**/Thumbs.db)",

      "Read(./docker-data/**)",
      "Read(./.docker/**)",

      "Read(./**/*.log)",
      "Read(./logs/**)",

      "Read(./.terraform/**)",
      "Read(./terraform.tfstate)",
      "Read(./terraform.tfstate.backup)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",

      "Read(./coverage/**)",
      "Read(./.nyc_output/**)",
      "Read(./htmlcov/**)",

      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.gcloud/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(./**/serviceAccountKey.json)",
      "Read(./**/*credentials*.json)",
      "Read(./.npmrc)",
      "Read(./.pypirc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.gitconfig)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-my-marketplace": {
      "source": {
        "source": "github",
        "repo": "lukaskellerstein/claude-my-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "dev-tools-plugin@claude-my-marketplace": true,
    "office-plugin@claude-my-marketplace": true,
    "media-plugin@claude-my-marketplace": true,
    "design-plugin@claude-my-marketplace": true
  }
}
